# Jarvis AI — Production & Cloud Environment Configuration
# Copy this file to .env or set these in your Cloud Dashboard (e.g. Render, Koyeb, Hugging Face)

# Core AI & Telegram
BOT_TOKEN=your_telegram_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_optional

# Server Runtime
SERVER_MODE=true
PORT=5000
PYTHONUNBUFFERED=1

# Gmail & Security Breach Alerts
GMAIL_SENDER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password
ALERT_RECIPIENT_EMAIL=your_email@gmail.com
EMAIL_ALERTS_ENABLED=true
GMAIL_SMTP_SERVER=smtp.gmail.com
GMAIL_SMTP_PORT=587
DAILY_REPORT_HOUR=8

# Optional Integrations
STRIPE_PUBLIC_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
TAVILY_API_KEY=tvly-placeholder
